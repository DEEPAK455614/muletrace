# Copy to .env and adjust. Never commit real .env or secrets.
# SQLite default (verified local mode): leave unset.
# DATABASE_URL=sqlite:////absolute/path/to/data/muletrace.db
# PostgreSQL mode (e.g. docker-compose):
# DATABASE_URL=postgresql+psycopg2://muletrace:muletrace@127.0.0.1:5432/muletrace
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_UPLOAD_BYTES=26214400
MAX_CSV_ROWS=500000
