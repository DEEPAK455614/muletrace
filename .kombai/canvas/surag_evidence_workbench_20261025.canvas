    "var_f5e16c2dc336": {
      "type": "variant",
      "label": "Surag — network review dossier",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  :root { --paper:#080c12; --rail:#0b1017; --surface:#111821; --raised:#151f2b; --line:#263343; --line-soft:#1b2736; --ink:#e7edf5; --soft:#b1bfd0; --mute:#8292a7; --cyan:#59d5e8; --cyan-dim:#153642; --crit:#ff5964; --high:#ff9560; --amber:#e7b65b; --green:#55cf9a; }\n  body { margin:0; background:var(--paper); color:var(--ink); font-family:'IBM Plex Sans',sans-serif; font-size:14px; line-height:1.45; }\n  .mono { font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums; }\n  .display { font-family:'Space Grotesk',sans-serif; }\n  .icon { font-size:16px; line-height:1; }\n  .app { min-height:1660px; display:flex; background:var(--paper); }\n  .rail { width:238px; flex:0 0 238px; min-height:1660px; background:var(--rail); border-right:1px solid var(--line); padding:25px 16px 20px; display:flex; flex-direction:column; }\n  .brand { display:flex; align-items:center; gap:10px; padding:0 9px 25px; border-bottom:1px solid var(--line-soft); }\n  .brand-mark { width:30px; height:30px; display:grid; place-items:center; border:1px solid #3d8d9c; color:var(--cyan); border-radius:7px; background:#10202a; }\n  .brand-name { font-family:'Space Grotesk'; font-size:16px; font-weight:600; letter-spacing:-.02em; }\n  .brand-sub { color:var(--mute); font-size:10px; margin-top:1px; }\n  .rail-search { margin:18px 0 17px; height:34px; display:flex; align-items:center; gap:8px; padding:0 10px; color:var(--mute); border:1px solid var(--line); border-radius:5px; background:#0e151e; font-size:12px; }\n  .rail-search kbd { margin-left:auto; border:1px solid #334357; border-radius:3px; padding:1px 4px; color:#9aacbf; font-family:'IBM Plex Mono'; font-size:10px; }\n  .nav-label { color:#64748a; font-size:10px; letter-spacing:.08em; text-transform:uppercase; margin:5px 10px 7px; }\n  .nav { display:flex; flex-direction:column; gap:2px; }\n  .nav-item { min-height:35px; display:flex; align-items:center; gap:10px; padding:0 10px; border-radius:5px; color:#a5b4c6; font-size:13px; text-decoration:none; }\n  .nav-item.active { background:#142b35; color:var(--cyan); border-left:2px solid var(--cyan); padding-left:8px; }\n  .nav-item:hover { background:#111e2a; color:var(--ink); }\n  .nav-item .count { margin-left:auto; color:var(--crit); font-family:'IBM Plex Mono'; font-size:11px; }\n  .utility { margin-top:26px; padding-top:17px; border-top:1px solid var(--line-soft); }\n  .rail-foot { margin-top:auto; border-top:1px solid var(--line-soft); padding:16px 10px 0; color:var(--mute); font-size:11px; line-height:1.65; }\n  .dataset { margin-top:12px; padding:8px 9px; border:1px solid #534a2e; border-radius:4px; color:#e6bd70; background:#1d1b14; font-size:10.5px; line-height:1.45; }\n  .workspace { flex:1; min-width:0; }\n  .topbar { height:68px; border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; padding:0 34px; background:#0a0f16; }\n  .crumbs { color:var(--mute); font-size:12px; display:flex; gap:8px; align-items:center; }\n  .crumbs strong { color:var(--soft); font-weight:500; }\n  .top-context { display:flex; align-items:center; gap:20px; color:var(--mute); font-size:12px; }\n  .context-block { display:flex; flex-direction:column; gap:1px; }\n  .context-label { font-size:10px; color:#66778c; text-transform:uppercase; letter-spacing:.06em; }\n  .context-value { color:#b9c6d5; }\n  .main { padding:31px 36px 70px; max-width:1260px; }\n  .title-row { display:flex; justify-content:space-between; align-items:flex-start; gap:24px; padding-bottom:25px; border-bottom:1px solid var(--line); }\n  .title-row h1 { margin:0; font-family:'Space Grotesk'; font-size:29px; line-height:1.15; letter-spacing:-.03em; font-weight:600; }\n  .title-meta { display:flex; align-items:center; gap:10px; margin-top:9px; color:var(--soft); }\n  .network-id { font-family:'IBM Plex Mono'; font-size:13px; color:var(--cyan); }\n  .dot { width:3px; height:3px; background:#63758a; border-radius:50%; }\n  .disclaimer { margin-top:12px; color:#93a5ba; font-size:13px; max-width:650px; }\n  .header-actions { display:flex; gap:8px; padding-top:3px; flex-wrap:wrap; justify-content:flex-end; }\n  .btn { height:33px; padding:0 12px; border-radius:4px; border:1px solid #344458; background:#111a25; color:#c3d0de; font:500 12px 'IBM Plex Sans'; display:inline-flex; align-items:center; gap:7px; }\n  .btn.primary { border-color:#3c8997; color:#a8ecf3; background:#102830; }\n  .btn.quiet { border-color:transparent; background:transparent; color:#a4b3c5; }\n  .btn:hover { border-color:#59738b; color:#fff; }\n  .layout { display:grid; grid-template-columns:154px minmax(0,1fr); gap:30px; padding-top:26px; }\n  .index { position:sticky; top:24px; align-self:start; }\n  .index-title { color:#718299; text-transform:uppercase; font-size:10px; letter-spacing:.08em; margin:3px 0 12px; }\n  .index a { display:block; color:#8fa1b5; text-decoration:none; padding:8px 9px; margin-bottom:2px; border-left:1px solid #273547; font-size:12px; }\n  .index a.active { color:var(--cyan); border-left:2px solid var(--cyan); background:#10212b; padding-left:8px; }\n  .index a:hover { color:var(--ink); }\n  .dossier { min-width:0; }\n  .orientation { display:grid; grid-template-columns:minmax(0,1fr) 318px; border:1px solid var(--line); background:var(--surface); min-height:245px; }\n  .orientation-copy { padding:21px 23px; border-right:1px solid var(--line); }\n  .section-heading { margin:0; font-family:'Space Grotesk'; font-size:17px; font-weight:600; letter-spacing:-.02em; }\n  .section-help { margin:5px 0 18px; color:#93a3b6; font-size:13px; }\n  .facts { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:16px; }\n  .fact-label { color:#718197; text-transform:uppercase; letter-spacing:.06em; font-size:10px; }\n  .fact-value { margin-top:4px; font-family:'IBM Plex Mono'; color:#e4ebf3; font-size:15px; }\n  .fact-value.risk { color:var(--high); }\n  .fact-value.link { color:var(--cyan); }\n  .network-note { border-top:1px solid var(--line-soft); margin-top:20px; padding-top:12px; color:#899aae; font-size:12px; }\n  .mini-graph { padding:17px 17px 12px; background:#0e151e; }\n  .mini-graph-head { display:flex; justify-content:space-between; align-items:center; color:#8395aa; font-size:11px; margin-bottom:7px; }\n  .legend { display:flex; gap:12px; color:#8da0b5; font-size:10px; }\n  .legend-item { display:flex; align-items:center; gap:4px; }\n  .legend-dot { width:6px; height:6px; border-radius:50%; }\n  .graph-svg { width:100%; height:162px; display:block; }\n  .graph-foot { font-size:10.5px; color:#708197; line-height:1.45; border-top:1px solid var(--line-soft); padding-top:8px; }\n  .register { margin-top:29px; border:1px solid var(--line); background:var(--surface); }\n  .register-head { display:flex; justify-content:space-between; align-items:flex-start; padding:20px 22px 17px; border-bottom:1px solid var(--line); }\n  .register-sub { font-size:12px; color:#91a1b5; margin-top:4px; }\n  .register-mode { color:#82dce8; background:#112b34; border:1px solid #275a65; font-size:11px; padding:4px 8px; border-radius:3px; }\n  .evidence-columns { display:grid; grid-template-columns:1fr 1fr 1fr; border-bottom:1px solid var(--line); }\n  .evidence-col { padding:17px 21px 20px; min-height:151px; }\n  .evidence-col + .evidence-col { border-left:1px solid var(--line); }\n  .col-title { font-size:11px; color:#aebdcd; font-weight:600; text-transform:uppercase; letter-spacing:.06em; }\n  .col-rule { width:30px; height:2px; background:#70879a; margin:9px 0 13px; }\n  .col-rule.cyan { background:var(--cyan); }\n  .col-rule.amber { background:var(--amber); }\n  .col-rule.green { background:var(--green); }\n  .evidence-row { display:flex; justify-content:space-between; gap:15px; padding:5px 0; font-size:12px; }\n  .evidence-row span:first-child { color:#8798ad; }\n  .evidence-row span:last-child { color:#dae3ec; text-align:right; }\n  .evidence-row .mono { font-size:11.5px; }\n  .subsection { padding:24px 22px 0; }\n  .subsection-head { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:12px; }\n  .subsection h3 { margin:0; font-family:'Space Grotesk'; font-size:16px; font-weight:600; }\n  .subsection-note { color:#8495a9; font-size:12px; }\n  .table-wrap { border-top:1px solid var(--line); }\n  table { width:100%; border-collapse:collapse; }\n  th { text-align:left; padding:10px 10px; color:#718197; font-size:10px; text-transform:uppercase; letter-spacing:.06em; font-weight:600; border-bottom:1px solid var(--line); }\n  td { padding:12px 10px; border-bottom:1px solid var(--line-soft); color:#ccd7e3; font-size:12.5px; vertical-align:middle; }\n  tbody tr:last-child td { border-bottom:0; }\n  tbody tr:hover { background:#14202b; }\n  th:first-child, td:first-child { padding-left:0; }\n  th:last-child, td:last-child { padding-right:0; }\n  .entity { color:#edf3f8; font-weight:500; }\n  .secondary { color:#7f92a8; font-family:'IBM Plex Mono'; font-size:10.5px; margin-top:2px; }\n  .relationship { color:#9db0c4; }\n  .factor { color:#b9cad8; }\n  .factor small { display:block; color:#7d90a5; font-size:11px; margin-top:2px; }\n  .score { font-family:'IBM Plex Mono'; font-weight:600; color:var(--high); }\n  .score.critical { color:var(--crit); }\n  .triage { color:#ddc37e; border:1px solid #655735; background:#252115; padding:3px 7px; border-radius:3px; font-size:11px; white-space:nowrap; }\n  .triage.new { color:#aab8c8; border-color:#3f5062; background:#17202b; }\n  .action-link { color:var(--cyan); font-size:11.5px; text-decoration:none; white-space:nowrap; }\n  .action-link:hover { text-decoration:underline; }\n  .register-foot { color:#75879e; font-size:11px; padding:12px 0 0; }\n  .txn-register { margin-top:26px; }\n  .txn-table td { font-size:12px; }\n  .txn-id { color:#9caec1; font-family:'IBM Plex Mono'; font-size:10.5px; }\n  .amount { color:#e7eef6; font-family:'IBM Plex Mono'; text-align:right; }\n  .date { color:#a8b7c7; font-family:'IBM Plex Mono'; font-size:11px; white-space:nowrap; }\n  .arrow { color:#6b8197; padding:0 5px; }\n  .showing { margin-top:9px; color:#8193a9; font-size:11.5px; }\n  .lower-grid { display:grid; grid-template-columns:1.15fr .85fr; gap:26px; margin-top:27px; padding-bottom:22px; }\n  .section-block { border-top:1px solid var(--line); padding-top:16px; }\n  .section-block h3 { margin:0 0 12px; font-family:'Space Grotesk'; font-size:16px; font-weight:600; }\n  .complaint-list { display:flex; flex-direction:column; gap:9px; }\n  .complaint { display:grid; grid-template-columns:132px 1fr 110px; gap:14px; padding:10px 0; border-bottom:1px solid var(--line-soft); }\n  .complaint:last-child { border-bottom:0; }\n  .complaint-ref { color:var(--cyan); font-family:'IBM Plex Mono'; font-size:11px; }\n  .complaint-main { color:#d9e2ea; font-size:12px; }\n  .complaint-main small { display:block; color:#8092a8; margin-top:3px; font-size:11px; }\n  .complaint-amount { text-align:right; color:#dde6ef; font-family:'IBM Plex Mono'; font-size:11.5px; }\n  .identifier-table { border-top:1px solid var(--line); }\n  .identifier-row { display:grid; grid-template-columns:90px 1fr; gap:15px; padding:10px 0; border-bottom:1px solid var(--line-soft); }\n  .identifier-label { color:#8496aa; }\n  .identifier-value { color:#d5e0ea; }\n  .identifier-value small { display:block; color:#7f91a7; font-family:'IBM Plex Mono'; font-size:10.5px; margin-top:3px; }\n  .decision { border-top:1px solid var(--line); padding-top:17px; margin-top:2px; }\n  .decision-top { display:flex; align-items:center; justify-content:space-between; gap:16px; }\n  .decision-state { color:#e3bc68; border:1px solid #675731; background:#272116; border-radius:3px; padding:4px 8px; font-size:11px; }\n  .decision-copy { color:#94a5b9; font-size:12px; margin:9px 0 12px; }\n  .history { display:flex; gap:12px; padding:9px 0; border-top:1px solid var(--line-soft); }\n  .history-time { width:112px; flex:0 0 112px; color:#7c8ea5; font-family:'IBM Plex Mono'; font-size:10.5px; }\n  .history-detail { color:#bcc9d7; font-size:12px; }\n  .history-hash { color:#6d8096; font-family:'IBM Plex Mono'; font-size:10px; margin-top:3px; }\n  .bottom-disclosure { border-top:1px solid var(--line); padding:16px 22px 20px; color:#8495a9; font-size:11.5px; display:flex; justify-content:space-between; gap:20px; }\n  @media(max-width:1000px){ .rail{width:205px;flex-basis:205px}.main{padding-left:24px;padding-right:24px}.orientation{grid-template-columns:1fr}.mini-graph{border-top:1px solid var(--line);}.orientation-copy{border-right:0}.layout{grid-template-columns:1fr}.index{position:static;display:flex;gap:5px;overflow:auto}.index-title{display:none}.index a{white-space:nowrap;border-left:0;border-bottom:1px solid #273547}.index a.active{border-left:0;border-bottom:2px solid var(--cyan);padding-left:9px} }\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout container\">\n<aside class=\"rail\" data-kid=\"1-1\" data-name=\"left sidebar navigation rail\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity block\"><div class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand mark container\"><i class=\"icon icon-git-branch\" data-kid=\"1-1-1-1-1\" data-name=\"git branch brand icon\"></i></div><div data-kid=\"1-1-1-2\" data-name=\"brand text wrapper\"><div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">Surag</div><div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand tagline text\">Financial crime intelligence</div></div></div>\n<div class=\"rail-search\" data-kid=\"1-1-2\" data-name=\"search input field\"><i class=\"icon ico