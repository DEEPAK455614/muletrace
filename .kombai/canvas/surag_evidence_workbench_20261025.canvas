      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  :root { --paper:#090c11; --rail:#0d1118; --surface:#111720; --raised:#161e28; --line:#273241; --line-soft:#1c2530; --ink:#e6edf5; --soft:#a9b6c7; --mute:#718197; --cyan:#49d7e8; --cyan-dim:#163743; --red:#f06a72; --orange:#f2a65a; --amber:#e4bf69; --green:#54c89a; --blue:#73a7ff; }\n  .plex { font-family:'IBM Plex Sans',system-ui,sans-serif; }\n  .grotesk { font-family:'Space Grotesk',system-ui,sans-serif; }\n  .mono { font-family:'IBM Plex Mono',ui-monospace,monospace; font-variant-numeric:tabular-nums; }\n  .scrollbar::-webkit-scrollbar { width:5px; height:5px; } .scrollbar::-webkit-scrollbar-thumb { background:#334153; border-radius:4px; }\n  .hairline { border-color:var(--line); }\n</style>\n<div class=\"plex min-h-screen bg-[var(--paper)] text-[var(--ink)] flex overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-size:14px;\">\n<aside class=\"w-[238px] shrink-0 bg-[var(--rail)] border-r border-[var(--line)] flex flex-col min-h-screen\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<div class=\"px-5 pt-5 pb-4 border-b border-[var(--line)]\" data-kid=\"1-1-1\" data-name=\"sidebar header with brand and status\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name row\">\n<div class=\"w-8 h-8 flex items-center justify-center border border-[var(--cyan)] text-[var(--cyan)] rounded-sm\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n<i aria-hidden=\"true\" class=\"icon-git-branch text-[18px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"git branch logo icon\"></i>\n</div>\n<div data-kid=\"1-1-1-1-2\" data-name=\"brand text block\">\n<div class=\"grotesk text-[17px] font-semibold tracking-[-0.02em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name title\">Surag</div>\n<div class=\"text-[11px] text-[var(--mute)] mt-0.5\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand tagline text\">Financial crime intelligence</div>\n</div>\n</div>\n<div class=\"mt-4 flex items-center gap-2 text-[11px] text-[var(--amber)]\" data-kid=\"1-1-1-2\" data-name=\"demo status indicator\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-[var(--amber)]\" data-kid=\"1-1-1-2-1\" data-name=\"amber status dot\"></span>\n<span data-kid=\"1-1-1-2-2\" data-name=\"demo disclaimer text\">Demo · synthetic data</span>\n</div>\n</div>\n<div class=\"px-4 pt-4\" data-kid=\"1-1-2\" data-name=\"search action container\">\n<button class=\"w-full flex items-center justify-between rounded-sm border border-[var(--line)] bg-[var(--surface)] px-3 py-2.5 text-[12px] text-[var(--soft)]\" data-kid=\"1-1-2-1\" data-name=\"global search button\">\n<span class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-1\" data-name=\"search button label with icon\"><i class=\"icon-search text-[14px]\" data-kid=\"1-1-2-1-1-1\" data-name=\"magnifying glass search icon\"></i>Search accounts</span>\n<span class=\"mono text-[10px] text-[var(--mute)] border border-[var(--line)] px-1.5 py-0.5 rounded-sm\" data-kid=\"1-1-2-1-2\" data-name=\"keyboard shortcut hint\">⌘K</span>\n</button>\n</div>\n<nav class=\"px-3 pt-5 space-y-1\" data-kid=\"1-1-3\" data-name=\"investigation navigation menu\">\n<div class=\"px-3 pb-2 text-[10px] font-semibold tracking-[0.12em] uppercase text-[var(--mute)]\" data-kid=\"1-1-3-1\" data-name=\"investigation section label\">Investigation</div>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-sm text-[13px] text-[var(--soft)]\" data-kid=\"1-1-3-2\" data-name=\"overview nav link\" href=\"#\"><i class=\"icon-layout-dashboard text-[15px]\" data-kid=\"1-1-3-2-1\" data-name=\"dashboard icon\"></i>Overview</a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-sm bg-[var(--cyan-dim)] text-[var(--cyan)] font-medium\" data-kid=\"1-1-3-3\" data-name=\"network intelligence nav link (active)\" href=\"#\"><i class=\"icon-git-branch text-[15px]\" data-kid=\"1-1-3-3-1\" data-name=\"git branch icon\"></i>Network intelligence</a>\n<a class=\"flex items-center justify-between px-3 py-2.5 rounded-sm text-[13px] text-[var(--soft)]\" data-kid=\"1-1-3-4\" data-name=\"alert queue nav link with count\" href=\"#\"><span class=\"flex items-center gap-3\" data-kid=\"1-1-3-4-1\" data-name=\"alert queue label with icon\"><i class=\"icon-list-checks text-[15px]\" data-kid=\"1-1-3-4-1-1\" data-name=\"check list icon\"></i>Alert queue</span><span class=\"mono text-[11px] text-[var(--orange)]\" data-kid=\"1-1-3-4-2\" data-name=\"alert count badge\">18</span></a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-sm text-[13px] text-[var(--soft)]\" data-kid=\"1-1-3-5\" data-name=\"money trails nav link\" href=\"#\"><i class=\"icon-git-pull-request text-[15px]\" data-kid=\"1-1-3-5-1\" data-name=\"pull request icon\"></i>Money trails</a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-sm text-[13px] text-[var(--soft)]\" data-kid=\"1-1-3-6\" data-name=\"complaints nav link\" href=\"#\"><i class=\"icon-file-search text-[15px]\" data-kid=\"1-1-3-6-1\" data-name=\"file search icon\"></i>Complaints</a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-sm text-[13px] text-[var(--soft)]\" data-kid=\"1-1-3-7\" data-name=\"audit trail nav link\" href=\"#\"><i class=\"icon-history text-[15px]\" data-kid=\"1-1-3-7-1\" data-name=\"history clock icon\"></i>Audit trail</a>\n</nav>\n<nav class=\"px-3 pt-7 space-y-1\" data-kid=\"1-1-4\" data-name=\"utilities navigation menu\">\n<div class=\"px-3 pb-2 text-[10px] font-semibold tracking-[0.12em] uppercase text-[var(--mute)]\" data-kid=\"1-1-4-1\" data-name=\"utilities section label\">Utilities</div>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-sm text-[13px] text-[var(--soft)]\" data-kid=\"1-1-4-2\" data-name=\"evaluation nav link\" href=\"#\"><i class=\"icon-flask-conical text-[15px]\" data-kid=\"1-1-4-2-1\" data-name=\"flask icon\"></i>Evaluation</a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-sm text-[13px] text-[var(--soft)]\" data-kid=\"1-1-4-3\" data-name=\"methodology nav link\" href=\"#\"><i class=\"icon-book-open text-[15px]\" data-kid=\"1-1-4-3-1\" data-name=\"open book icon\"></i>Methodology</a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-sm text-[13px] text-[var(--soft)]\" data-kid=\"1-1-4-4\" data-name=\"import data nav link\" href=\"#\"><i class=\"icon-upload text-[15px]\" data-kid=\"1-1-4-4-1\" data-name=\"upload icon\"></i>Import data</a>\n</nav>\n<div class=\"mt-auto px-5 py-5 border-t border-[var(--line)] text-[11px] leading-[1.55] text-[var(--mute)]\" data-kid=\"1-1-5\" data-name=\"sidebar dataset footer\">\n<div class=\"text-[var(--soft)] mb-1\" data-kid=\"1-1-5-1\" data-name=\"active dataset label\">Active dataset</div>\n<div class=\"mono text-[10.5px]\" data-kid=\"1-1-5-2\" data-name=\"dataset identifier text\">synthetic / Jan–Oct 2026</div>\n<div class=\"mt-3\" data-kid=\"1-1-5-3\" data-name=\"score disclaimer text\">Scores rank suspicion for review. They are not findings of guilt.</div>\n</div>\n</aside>\n<main class=\"min-w-0 flex-1 overflow-y-auto scrollbar\" data-kid=\"1-2\" data-name=\"main scrollable content area\">\n<header class=\"h-[64px] border-b border-[var(--line)] bg-[var(--paper)] flex items-center justify-between px-8\" data-kid=\"1-2-1\" data-name=\"top page header bar\">\n<div class=\"flex items-center gap-2 text-[12px] text-[var(--mute)]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\"><span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb first segment\">Network intelligence</span><span class=\"text-[var(--line)]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator\">/</span><span class=\"text-[var(--ink)]\" data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb current page\">Money trail reconstruction</span></div>\n<div class=\"flex items-center gap-4 text-[11px] text-[var(--mute)]\" data-kid=\"1-2-1-2\" data-name=\"header meta info and actions\"><span class=\"mono\" data-kid=\"1-2-1-2-1\" data-name=\"dataset identifier display\">Dataset: SYN-2026-10</span><span class=\"w-px h-4 bg-[var(--line)]\" data-kid=\"1-2-1-2-2\" data-name=\"vertical divider line\"></span><button class=\"text-[var(--soft)] flex items-center gap-1.5\" data-kid=\"1-2-1-2-3\" data-name=\"methodology help button\"><i class=\"icon-circle-help text-[14px]\" data-kid=\"1-2-1-2-3-1\" data-name=\"help circle icon\"></i>Methodology</button></div>\n</header>\n<div class=\"px-8 pt-7 pb-12 max-w-[1240px]\" data-kid=\"1-2-2\" data-name=\"main content wrapper\">\n<div class=\"flex items-start justify-between gap-8 mb-6\" data-kid=\"1-2-2-1\" data-name=\"page title row with context\">\n<div data-kid=\"1-2-2-1-1\" data-name=\"page title block\">\n<div class=\"flex items-center gap-3 mb-2\" data-kid=\"1-2-2-1-1-1\" data-name=\"page title with network badge\"><h1 class=\"grotesk text-[25px] leading-tight font-semibold tracking-[-0.025em]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"page headline\">Chronological reconstruction</h1><span class=\"mono text-[11px] text-[var(--cyan)] border border-[#285462] bg-[#112a32] px-2 py-1 rounded-sm\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"network identifier badge\">NETWORK #12</span></div>\n<p class=\"text-[13px] text-[var(--soft)] max-w-[690px] leading-[1.55]\" data-kid=\"1-2-2-1-1-2\" data-name=\"reconstruction description text\">Trace observed transactions from <span class=\"mono text-[var(--ink)]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"source account reference\">ACC-041</span> through the selected community. This reconstruction follows observed transaction order and allocation assumptions.</p>\n</div>\n<div class=\"text-right shrink-0 pt-1\" data-kid=\"1-2-2-1-2\" data-name=\"context summary block\"><div class=\"text-[11px] text-[var(--mute)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"context label\">Context</div><div class=\"mono text-[12px] text-[var(--soft)] mt-1\" data-kid=\"1-2-2-1-2-2\" data-name=\"context statistics text\">Network #12 · 21 accounts · 4 complaints</div><a class=\"text-[12px] text-[var(--cyan)] inline-flex items-center gap-1 mt-2\" data-kid=\"1-2-2-1-2-3\" data-name=\"return to network link\" href=\"#\"><i class=\"icon-arrow-left text-[13px]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"left arrow icon\"></i>Return to network</a></div>\n</div>\n<div class=\"border-y border-[var(--line)] bg-[var(--surface)] px-4 py-4 mb-6\" data-kid=\"1-2-2-2\" data-name=\"trace query parameter panel\">\n<div class=\"flex items-end gap-4\" data-kid=\"1-2-2-2-1\" data-name=\"query parameter controls row\">\n<div class=\"w-[176px]\" data-kid=\"1-2-2-2-1-1\" data-name=\"source mode selector\"><label class=\"block text-[11px] text-[var(--mute)] mb-1.5\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"source mode label\">Source mode</label><div class=\"flex border border-[var(--line)] rounded-sm overflow-hidden h-[36px]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"mode toggle group\"><button class=\"flex-1 bg-[var(--cyan)] text-[#071117] text-[12px] font-semibold\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"account mode button (active)\">Account</button><button class=\"flex-1 bg-[var(--surface)] text-[var(--soft)] text-[12px]\" data-kid=\"1-2-2-2-1-1-2-2\" data-name=\"complaint mode button\">Complaint ref.</button></div></div>\n<div class=\"w-[170px]\" data-kid=\"1-2-2-2-1-2\" data-name=\"account ID input field\"><label class=\"block text-[11px] text-[var(--mute)] mb-1.5\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"account ID label\">Account ID</label><div class=\"h-[36px] border border-[#3e6570] bg-[#0d151d] rounded-sm px-3 flex items-center mono text-[12px] text-[var(--ink)]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"account ID value field\">ACC-041</div></div>\n<div class=\"w-[220px]\" data-kid=\"1-2-2-2-1-3\" data-name=\"direction selector\"><label class=\"block text-[11px] text-[var(--mute)] mb-1.5\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"direction label\">Direction</label><div class=\"h-[36px] border border-[var(--line)] bg-[var(--paper)] rounded-sm px-3 flex items-center justify-between text-[12px] text-[var(--ink)]\" data-kid=\"1-2-2-2-1-3-2\" data-name=\"direction dropdown display\"><span data-kid=\"1-2-2-2-1-3-2-1\" data-name=\"direction value text\">Forward · where did money go</span><i class=\"icon-chevron-down text-[14px] text-[var(--mute)]\" data-kid=\"1-2-2-2-1-3-2-2\" data-name=\"chevron down dropdown icon\"></i></div></div>\n<div class=\"w-[138px]\" data-kid=\"1-2-2-2-1-4\" data-name=\"time window selector\"><label class=\"block text-[11px] text-[var(--mute)] mb-1.5\" data-kid=\"1-2-2-2-1-4-1\" data-name=\"window label\">Window</label><div class=\"h-[36px] border border-[var(--line)] bg-[var(--paper)] rounded-sm px-3 flex items-center justify-between mono text-[12px] text-[var(--ink)]\" data-kid=\"1-2-2-2-1-4-2\" data-name=\"window dropdown display\"><span data-kid=\"1-2-2-2-1-4-2-1\" data-name=\"window value text\">30 days</span><i class=\"icon-chevron-down text-[14px] text-[var(--mute)]\" data-kid=\"1-2-2-2-1-4-2-2\" data-name=\"chevron down dropdown icon\"></i></div></div>\n<button class=\"h-[36px] px-5 rounded-sm bg-[var(--cyan)] text-[#071117] text-[12px] font-semibold flex items-center gap-2\" data-kid=\"1-2-2-2-1-5\" data-name=\"trace funds action button\"><i class=\"icon-git-branch text-[14px]\" data-kid=\"1-2-2-2-1-5-1\" data-name=\"git branch trace icon\"></i>Trace funds</button>\n<div class=\"ml-auto text-[11px] text-[var(--amber)] flex items-center gap-2 pb-2\" data-kid=\"1-2-2-2-1-6\" data-name=\"parameter change notice\"><span class=\"w-1.5 h-1.5 rounded-full bg-[var(--amber)]\" data-kid=\"1-2-2-2-1-6-1\" data-name=\"amber status dot\"></span>Parameters changed; run trace to update</div>\n</div>\n</div>\n<div class=\"grid grid-cols-[minmax(0,1.12fr)_minmax(360px,.88fr)] gap-5 items-start\" data-kid=\"1-2-2-3\" data-name=\"trace visualization grid\">\n<section class=\"border border-[var(--line)] bg-[var(--surface)]\" data-kid=\"1-2-2-3-1\" data-name=\"observed path section\">\n<div class=\"px-5 py-4 border-b border-[var(--line)] flex items-center justify-between\" data-kid=\"1-2-2-3-1-1\" data-name=\"observed path section header\"><div data-kid=\"1-2-2-3-1-1-1\" data-name=\"section title block\"><h2 class=\"grotesk text-[15px] font-semibold\" data-kid=\"1-2-2-3-1-1-1-1\" data-name=\"section title\">Observed path</h2><p class=\"text-[12px] text-[var(--mute)] mt-1\" data-kid=\"1-2-2-3-1-1-1-2\" data-name=\"section subtitle\">Forward trace · 30-day window · 6 qualifying hops</p></div><div class=\"flex items-center gap-3 text-[11px] text-[var(--mute)]\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"score legend\"><span class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-3-1-1-2-1\" data-name=\"high score legend item\"><span class=\"w-2 h-2 rounded-full bg-[var(--red)]\" data-kid=\"1-2-2-3-1-1-2-1-1\" data-name=\"red legend dot\"></span>score ≥ 75</span><span class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-3-1-1-2-2\" data-name=\"mid score legend item\"><span class=\"w-2 h-2 rounded-full bg-[var(--orange)]\" data-kid=\"1-2-2-3-1-1-2-2-1\" data-name=\"orange legend dot\"></span>score ≥ 45</span></div></div>\n<div class=\"p-5\" data-kid=\"1-2-2-3-1-2\" data-name=\"observed path content\">\n<div class=\"h-[290px] border border-[var(--line-soft)] bg-[#0b1016] relative overflow-hidden\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"transaction path diagram canvas\">\n<div class=\"absolute top-3 left-3 text-[10px] text-[var(--mute)] mono\" data-kid=\"1-2-2-3-1-2-1-1\" data-name=\"diagram disclaimer label\">OBSERVED TRANSACTIONS · NOT PREDICTION</div>\n<svg aria-label=\"Observed directed transaction path\" class=\"absolute left-3 right-3 top-8 w-[calc(100%-24px)] h-[235px]\" data-kid=\"1-2-2-3-1-2-1-2\" data-name=\"transaction path SVG diagram\" viewbox=\"0 0 690 250\">\n<defs><marker id=\"