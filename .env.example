# Copy to .env and adjust locally. Never commit real secrets.
# PostgreSQL primary (docker-compose up db):
DATABASE_URL=postgresql+psycopg2://muletrace:muletrace@localhost:5432/muletrace
# SQLite local fallback (same migrations and tests must pass in both modes):
# DATABASE_URL=sqlite:///./data/muletrace.db
UPLOAD_DIR=data/incoming
MAX_UPLOAD_BYTES=26214400
MAX_CSV_ROWS=500000
